{
  "name": "@nytlex/auth",
  "description": "Authentication package for Nytlex.js framework",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "private": false,
  "author": "mfraz",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.20.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.js",
      "require": "./dist/vue/index.js"
    },
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "import": "./dist/svelte/index.js",
      "require": "./dist/svelte/index.js"
    }
  },
  "keywords": [
    "hightjs",
    "nytejs",
    "nyte",
    "nytlex",
    "nytlex",
    "auth",
    "authentication",
    "framework"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && npx cpx2 \"src/**/**/**/*.{svelte,vue,d.ts}\" dist",
    "build:watch": "tsc --watch",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "typescript": "^6.0.3",
    "vue": "^3.5.38"
  },
  "peerDependencies": {
    "nytlex": "workspace:^",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "svelte": "^5.56.3",
    "vue": "^3.5.27"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  },
  "dependencies": {
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.1",
    "cpx2": "^9.0.0"
  }
}
